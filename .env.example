# Copie este arquivo para .env.local e preencha os valores.
# NUNCA versione o .env.local (ele está no .gitignore).

# ── Firebase (cliente) ──────────────────────────────────────────────
# Painel do Firebase > Configurações do projeto > Seus apps > Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (servidor) ───────────────────────────────────────
# Painel do Firebase > Configurações do projeto > Contas de serviço >
# Gerar nova chave privada. Do JSON baixado:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave privada inteira, com os \n literais (uma linha só, entre aspas):
FIREBASE_PRIVATE_KEY=""

# ── Google Gemini ───────────────────────────────────────────────────
# https://aistudio.google.com/apikey  (usado para embeddings e como IA de fallback)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# ── Provedores de IA adicionais (opcionais) ─────────────────────────
# Chave de cada provedor que aparecer na AI_CHAIN.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# CEREBRAS_API_KEY=

# Ordem de prioridade dos modelos: "provedor:modelo,provedor:modelo,...".
# O primeiro é tentado primeiro; se falhar, cai para o próximo.
AI_CHAIN=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b,google:gemini-2.5-flash-lite

# ── Segredos internos ───────────────────────────────────────────────
# Gere valores aleatórios (ex: `openssl rand -hex 32`).
CRON_SECRET=
EVAL_SECRET=

# ── Ajustes finos (opcionais, têm padrão no código) ─────────────────
# SEARCH_TOP_K=8
# SEARCH_MIN_SIMILARITY=0.4
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=600000
